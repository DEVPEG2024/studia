<template>
  <div class="page">

    <!-- Bandeau mince : la phase, et les sets deja joues -->
    <div class="matchline">
      <text class="phase">{{ phaseText }}</text>
      <text class="history">{{ historyText }}</text>
    </div>

    <!-- Le terrain : la moitie gauche compte pour NOUS, la droite pour EUX.
         Le camp au service porte sa plaque pleine, lisible en plein soleil. -->
    <div class="field">
      <div class="court">
      <div class="half" onclick="scoreA">
        <div class="plate {{ plateClassA }}">
          <text class="team {{ teamClassA }}">{{ teamA }}</text>
          <text class="sets {{ setsClassA }}">{{ setsA }}</text>
        </div>
        <text class="serve serve-a">{{ serveA }}</text>
        <text class="point {{ pointClassA }}">{{ pointA }}</text>
        <div class="games" show="{{ !finished }}">
          <text class="games-n">{{ gamesA }}</text>
          <text class="games-l">JEUX</text>
        </div>
      </div>

      <div class="net"></div>

      <div class="half" onclick="scoreB">
        <div class="plate {{ plateClassB }}">
          <text class="team {{ teamClassB }}">{{ teamB }}</text>
          <text class="sets {{ setsClassB }}">{{ setsB }}</text>
        </div>
        <text class="serve serve-b">{{ serveB }}</text>
        <text class="point {{ pointClassB }}">{{ pointB }}</text>
        <div class="games" show="{{ !finished }}">
          <text class="games-n">{{ gamesB }}</text>
          <text class="games-l">JEUX</text>
        </div>
      </div>
      </div>

      <!-- Etat de la balle : colle au score, dont il fait partie -->
      <div class="ballstate">
        <text class="status-text {{ statusClass }}">{{ statusText }}</text>
      </div>
    </div>

    <!-- Deux commandes seulement : « nouveau match » vit dans les reglages,
         ou une faute de frappe ne coute pas le score en cours. -->
    <div class="bar">
      <div class="btn btn-wide" onclick="undoPoint">
        <text class="btn-text {{ undoClass }}">ANNULER</text>
      </div>
      <div class="btn" onclick="openSettings">
        <text class="btn-text">REGLAGES</text>
      </div>
    </div>

  </div>
</template>

<style>
/* Un terrain de padel vu du dessus, pense pour 390 x 450 : le point occupe
   le tiers de la dalle, tout le reste est rogne. Vela ne gere pas les
   degrades, la charte du telephone est transposee en aplats. */
.page {
  flex: 1;
  flex-direction: column;
  background-color: #0a1018;
}

/* --- bandeau mince : 30 px, pas 44 --- */
.matchline {
  height: 30px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 14px;
  padding-right: 14px;
}
.phase {
  font-size: 11px;
  font-weight: bold;
  color: #6b7f93;
}
.history {
  font-size: 12px;
  color: #4d5f70;
  text-align: right;
}

/* --- les deux camps --- */
/* Le score et l'etat de la balle forment un bloc, centre d'un seul tenant :
   sinon l'oeil traverse deux vides avant d'atteindre l'information. */
.field {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  border-top-width: 1px;
  border-top-color: #1a2532;
}
.court {
  flex-direction: row;
  align-items: center;
}
.half {
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-left: 4px;
  padding-right: 4px;
}
.net {
  width: 2px;
  height: 150px;
  background-color: #22303f;
}

/* Plaque d'equipe. Au service, elle se remplit de la couleur du camp :
   a bout de bras, un aplat se voit, une pastille non. */
.plate {
  flex-direction: row;
  align-items: center;
  height: 24px;
  border-radius: 12px;
  padding-left: 9px;
  padding-right: 9px;
  margin-bottom: 6px;
}
.pl-a { background-color: #e4f24a; }
.pl-b { background-color: #57b0ff; }
.team {
  font-size: 13px;
  font-weight: bold;
  color: #6b7f93;
  margin-right: 6px;
}
.tm-on { color: #0a1018; }
.sets {
  font-size: 13px;
  font-weight: bold;
  color: #6b7f93;
  text-align: center;
}
.sn-a { color: #e4f24a; }
.sn-b { color: #57b0ff; }
.sn-on { color: #0a1018; }

/* Ligne de service : presente des deux cotes meme vide, sinon les deux gros
   scores ne seraient plus alignes. */
.serve {
  height: 16px;
  font-size: 11px;
  font-weight: bold;
  text-align: center;
  width: 100%;
}
.serve-a { color: #e4f24a; }
.serve-b { color: #57b0ff; }

.point {
  font-size: 104px;
  font-weight: bold;
  text-align: center;
  width: 100%;
  height: 128px;
}
.pt-a { color: #e4f24a; }
.pt-b { color: #57b0ff; }
.pt-dim { color: #2c3948; }

.games {
  flex-direction: row;
  align-items: flex-end;
  height: 28px;
}
.games-n {
  font-size: 24px;
  font-weight: bold;
  color: #e8eef5;
  margin-right: 4px;
}
.games-l {
  font-size: 10px;
  font-weight: bold;
  color: #6b7f93;
  margin-bottom: 4px;
}

/* --- etat de la balle --- */
.ballstate {
  height: 28px;
  margin-top: 10px;
  justify-content: center;
  align-items: center;
}
.status-text {
  font-size: 12px;
  font-weight: bold;
  text-align: center;
  width: 100%;
}
.sl-none { color: #0a1018; }
.sl-a { color: #e4f24a; }
.sl-b { color: #57b0ff; }
.sl-warn { color: #ffb340; }
.sl-neutral { color: #e8eef5; }

/* --- deux commandes --- */
.bar {
  height: 52px;
  flex-direction: row;
  align-items: center;
  padding-left: 10px;
  padding-right: 10px;
  padding-bottom: 10px;
}
.btn {
  flex: 1;
  height: 42px;
  background-color: #131c27;
  border-width: 1px;
  border-color: #22303f;
  border-radius: 12px;
  margin-left: 3px;
  margin-right: 3px;
  justify-content: center;
  align-items: center;
}
.btn-wide { flex: 1.7; }
.btn-text {
  font-size: 12px;
  font-weight: bold;
  color: #a9bccd;
  text-align: center;
  width: 100%;
}
.btn-text-off { color: #3a4756; }
</style>

<script>
import router from '@system.router'
import engine from '../../common/padel-engine.js'
import device from '../../common/device.js'
import store from '../../common/store.js'

// Etat hors systeme reactif : le match porte une pile d'annulation
// qu'il serait inutile (et couteux) d'observer.
let match = null
let settings = null

const BALL_LABELS = { game: 'BALLE DE JEU', set: 'BALLE DE SET', match: 'BALLE DE MATCH' }
const BALL_RANK = { game: 1, set: 2, match: 3 }

export default {
  data: {
    teamA: 'NOUS',
    teamB: 'EUX',
    phaseText: 'SET 1',
    historyText: '',
    setsA: '0',
    setsB: '0',
    setsClassA: 'sn-a',
    setsClassB: 'sn-b',
    teamClassA: '',
    teamClassB: '',
    plateClassA: '',
    plateClassB: '',
    serveA: '',
    serveB: '',
    pointA: '0',
    pointB: '0',
    gamesA: '0',
    gamesB: '0',
    pointClassA: 'pt-a',
    pointClassB: 'pt-b',
    finished: false,
    statusText: '',
    statusClass: 'sl-none',
    undoClass: 'btn-text-off'
  },

  onShow() {
    const self = this
    store.loadSettings(function (loaded) {
      settings = loaded
      device.keepScreenOn(settings.keepScreenOn)
      store.takeReset(function (resetRequested) {
        if (resetRequested) match = null
        if (match) {
          self.refresh()
          return
        }
        store.loadMatch(function (raw) {
          match = engine.deserialize(raw) || engine.createMatch(self.configFromSettings())
          self.refresh()
        })
      })
    })
  },

  onDestroy() {
    device.keepScreenOn(false)
  },

  configFromSettings() {
    const s = settings || store.DEFAULT_SETTINGS
    return {
      goldenPoint: s.goldenPoint,
      superTieBreak: s.superTieBreak,
      setsToWin: s.setsToWin
    }
  },

  /* --------------------------- actions --------------------------- */

  scoreA() {
    this.addPoint(0)
  },

  scoreB() {
    this.addPoint(1)
  },

  addPoint(team) {
    if (!match || match.finished) return
    const setsBefore = match.setHistory.length
    const gamesBefore = match.games[0] + match.games[1]
    engine.addPoint(match, team)
    const gameEnded =
      match.finished ||
      match.setHistory.length !== setsBefore ||
      match.games[0] + match.games[1] !== gamesBefore
    this.buzz(gameEnded ? 'long' : 'short')
    store.saveMatch(engine.serialize(match))
    this.refresh()
  },

  undoPoint() {
    if (!match || !engine.undo(match)) return
    this.buzz('short')
    store.saveMatch(engine.serialize(match))
    this.refresh()
  },

  openSettings() {
    try {
      router.push({ uri: '/pages/Settings' })
    } catch (e) {
      console.info('Padel : navigation impossible - ' + e)
    }
  },

  buzz(mode) {
    if (settings && settings.vibration) device.vibrate(mode)
  },

  /* --------------------------- affichage --------------------------- */

  refresh() {
    const m = match
    if (!m) return
    const status = engine.pointStatus(m)
    const server = engine.currentServer(m)

    this.teamA = m.config.teams[0]
    this.teamB = m.config.teams[1]
    this.finished = m.finished

    this.phaseText = m.finished
      ? 'MATCH TERMINE'
      : m.superTieBreak
        ? 'SUPER TIE-BREAK'
        : m.tieBreak ? 'JEU DECISIF' : 'SET ' + engine.currentSetNumber(m)

    // Les sets gagnes appartiennent a chaque camp ; le bandeau ne garde que
    // les sets deja joues.
    this.historyText = engine.setSummary(m).join(' · ')
    this.setsA = String(m.sets[0])
    this.setsB = String(m.sets[1])
    // Au service, la plaque se remplit : un aplat se voit a bout de bras.
    const servingA = !m.finished && server === 0
    const servingB = !m.finished && server === 1
    this.plateClassA = servingA ? 'pl-a' : ''
    this.plateClassB = servingB ? 'pl-b' : ''
    this.teamClassA = servingA ? 'tm-on' : ''
    this.teamClassB = servingB ? 'tm-on' : ''
    this.setsClassA = servingA ? 'sn-on' : 'sn-a'
    this.setsClassB = servingB ? 'sn-on' : 'sn-b'

    // On engage a droite en debut de jeu, puis on alterne a chaque point.
    const cote = engine.servingCourt(m) === 'right' ? 'DROITE' : 'GAUCHE'
    this.serveA = servingA ? 'SERVICE ' + cote : ''
    this.serveB = servingB ? 'SERVICE ' + cote : ''

    if (m.finished) {
      // Points et jeux sont remis a zero : on affiche les sets gagnes.
      this.pointA = String(m.sets[0])
      this.pointB = String(m.sets[1])
      this.pointClassA = m.winner === 0 ? 'pt-a' : 'pt-dim'
      this.pointClassB = m.winner === 1 ? 'pt-b' : 'pt-dim'
    } else {
      this.pointA = engine.pointLabel(m, 0)
      this.pointB = engine.pointLabel(m, 1)
      this.gamesA = String(m.games[0])
      this.gamesB = String(m.games[1])
      this.pointClassA = 'pt-a'
      this.pointClassB = 'pt-b'
    }

    this.undoClass = engine.canUndo(m) ? '' : 'btn-text-off'
    this.applyStatus(m, status)
  },

  applyStatus(m, status) {
    if (m.finished) {
      this.statusText = 'VICTOIRE ' + m.config.teams[m.winner]
      this.statusClass = m.winner === 0 ? 'sl-a' : 'sl-b'
      return
    }
    if (m.changeEnds) {
      this.statusText = 'CHANGEMENT DE COTE'
      this.statusClass = 'sl-warn'
      return
    }
    // Avec les avantages, un point marque par l'un fait retomber l'autre
    // de AV a 40 : sans libelle, on croit a une inversion des cotes.
    if (!m.tieBreak && !m.config.goldenPoint) {
      if (m.points[0] === 4) {
        this.statusText = 'AVANTAGE ' + m.config.teams[0]
        this.statusClass = 'sl-a'
        return
      }
      if (m.points[1] === 4) {
        this.statusText = 'AVANTAGE ' + m.config.teams[1]
        this.statusClass = 'sl-b'
        return
      }
      if (m.points[0] === 3 && m.points[1] === 3) {
        this.statusText = 'EGALITE'
        this.statusClass = 'sl-neutral'
        return
      }
    }

    const a = status.teams[0]
    const b = status.teams[1]
    if (!a && !b) {
      this.statusText = ''
      this.statusClass = 'sl-none'
      return
    }
    if (a && b) {
      const best = BALL_RANK[a] >= BALL_RANK[b] ? a : b
      this.statusText = best === 'game' && status.golden ? 'POINT EN OR' : BALL_LABELS[best]
      this.statusClass = 'sl-warn'
      return
    }
    this.statusText = BALL_LABELS[a || b]
    this.statusClass = a ? 'sl-a' : 'sl-b'
  }
}
</script>
