{
  "package": "com.padel.compteur",
  "name": "Padel",
  "icon": "/common/logo.png",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1030,
  "config": {
    "logLevel": "log",
    "designWidth": 390
  },
  "features": [
    { "name": "system.router" },
    { "name": "system.storage" },
    { "name": "system.vibrator" },
    { "name": "system.brightness" }
  ],
  "router": {
    "entry": "pages/Index",
    "pages": {
      "pages/Index": {
        "component": "index"
      },
      "pages/Settings": {
        "component": "index"
      }
    }
  },
  "display": {
    "backgroundColor": "#000000",
    "fullScreen": true,
    "titleBar": false,
    "pages": {
      "pages/Index": {
        "titleBar": false,
        "fullScreen": true
      },
      "pages/Settings": {
        "titleBar": false,
        "fullScreen": true
      }
    }
  }
